SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
LLM_API_KEY=your-openai-compatible-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
CRON_SECRET=replace-with-a-random-secret

# Public site URL used for OG tags (optional on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection string (Supabase > Project Settings > Database). Used only by `npm run db:push` / `db:seed`; never in app code.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
